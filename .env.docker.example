# ==============================================================================
# Docker Compose Environment Defaults (.env.docker.example)
# ==============================================================================
# These variables are consumed by docker-compose.yml to configure the local
# PostgreSQL container. They are NOT read by Django directly.
#
# When using local Docker Postgres, keep Django's DATABASE_URL in .env in sync:
# DATABASE_URL=postgresql://movie_network:movie_network_dev_password@localhost:5432/movie_network
# ==============================================================================

POSTGRES_DB=movie_network
POSTGRES_USER=movie_network
POSTGRES_PASSWORD=movie_network_dev_password
POSTGRES_PORT=5432
