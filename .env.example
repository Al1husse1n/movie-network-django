# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual environment values.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Django settings module: use movie_network.settings.dev for local, movie_network.settings.prod for production
DJANGO_SETTINGS_MODULE=movie_network.settings.dev

# Django Secret Key: generate a strong, random 50+ character string for production
SECRET_KEY=django-insecure-change-me-in-production-use-a-strong-secret-key

# Debug Mode: True for development, False for production
DEBUG=True

# Allowed Hosts: comma-separated list of host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Connection URL:
# For Neon / Postgres: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# The Movie Database (TMDB) API Key (v3 auth key)
TMDB_API_KEY=your-tmdb-api-key-here

# CSRF Trusted Origins: comma-separated list of trusted origins for production (e.g., https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1


# Google OAuth (from https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID (Web application) with authorized redirect URI:
#   http://127.0.0.1:8000/accounts/google/login/callback/
# For production, also add your prod domain's callback URI.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
