# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual environment values.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Django settings module: use movie_network.settings.dev for local, movie_network.settings.prod for production
DJANGO_SETTINGS_MODULE=movie_network.settings.dev

# Django Secret Key: generate a strong, random 50+ character string for production
SECRET_KEY=django-insecure-change-me-in-production-use-a-strong-secret-key

# Debug Mode: True for development, False for production
DEBUG=True

# Allowed Hosts: comma-separated list of host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Connection URL:
# For Neon / Postgres: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# The Movie Database (TMDB) API Key (v3 auth key)
TMDB_API_KEY=your-tmdb-api-key-here

# CSRF Trusted Origins: comma-separated list of trusted origins for production (e.g., https://yourdomain.com)
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1


# Google OAuth (from https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID (Web application) with authorized redirect URI:
#   http://127.0.0.1:8000/accounts/google/login/callback/
# For production, also add your prod domain's callback URI.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Production deployment (Render + Upstash + Neon) ---
# Set these in the Render dashboard (Environment tab), NOT in the committed .env.
# Required for the app to boot in production:
#   DJANGO_SETTINGS_MODULE=movie_network.settings.prod
#   DEBUG=False
#   SECRET_KEY=<generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
#   ALLOWED_HOSTS=movie-network-django.onrender.com
#   CSRF_TRUSTED_ORIGINS=https://movie-network-django.onrender.com
#   DATABASE_URL=<your Neon connection string>
#   REDIS_URL=<Upstash connection string starting with rediss://>
#   CHANNEL_LAYERS_URL=<same Upstash URL, or a different DB index like /2>
#   CELERY_BROKER_URL=<same Upstash URL, or a different DB index like /0>
#   TMDB_API_KEY=<production TMDB key>
#   GOOGLE_CLIENT_ID=<production Google client ID>
#   GOOGLE_CLIENT_SECRET=<production Google client secret>
#
# Upstash URL format (note rediss:// with two s's and ssl_cert_reqs=none):
#   rediss://default:<password>@<region>.upstash.io:6379?ssl_cert_reqs=none
#
# Google OAuth: add https://<your-app>.onrender.com/accounts/google/login/callback/
#   to Authorized redirect URIs in Google Cloud Console.
